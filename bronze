create or replace table silver_csv(
    transaction_id varchar(50),
    store_id varchar(20),
    store_name varchar(100),
    store_city varchar(100),
    store_region varchar(100),
    cashier_id varchar(20),
    customer_id varchar(20),
    transaction_date date,
    transaction_time time,
    product_sku varchar(40),
    product_name varchar(200),
    category varchar(100),
    subcategory varchar(100),
    quantity int,
    unit_price number(12,2),
    discount_pct number(5,2),
    total_amount number(12,2),
    payment_method varchar(50),
    loyalty_points number(10,2)
);

select * from silver_csv;

create or replace stream bronze_stream_csv
on table bronze_csv;

select    
    transaction_id,
    store_id,
    store_name,
    store_city,
    store_region,
    cashier_id,
    customer_id,
    transaction_date,
    transaction_time,
    product_sku,
    product_name,
    category,
    subcategory,
    quantity,
    unit_price,
    discount_pct,
    total_amount,
    payment_method,
    loyalty_points,
    metadata$action,
    metadata$isupdate,
    metadata$row_id
from bronze_stream_csv;


merge into silver_csv as sc
using bronze_stream_csv as bsc
on sc.transaction_id = bsc.transaction_id and sc.product_sku = bsc.product_sku
when matched
    and bsc.metadata$action = 'DELETE'
    and bsc.metadata$isupdate = FALSE
then delete

when matched
    and bsc.metadata$action = 'INSERT'
then update set
    sc.store_id = bsc.store_id,
    sc.store_name = bsc.store_name,
    sc.store_city = bsc.store_city,
    sc.store_region = bsc.store_region,
    sc.cashier_id = bsc.cashier_id,
    sc.customer_id = bsc.customer_id,
    sc.transaction_date = bsc.transaction_date,
    sc.transaction_time = bsc.transaction_time,
    sc.product_name = bsc.product_name,
    sc.category = bsc.category,
    sc.subcategory = bsc.subcategory,
    sc.quantity = bsc.quantity,
    sc.unit_price = bsc.unit_price,
    sc.discount_pct = bsc.discount_pct,
    sc.total_amount = bsc.total_amount,
    sc.payment_method = bsc.payment_method,
    sc.loyalty_points = bsc.loyalty_points

when not matched
    and bsc.METADATA$ACTION = 'INSERT'
then INSERT (
    transaction_id,
    store_id,
    store_name,
    store_city,
    store_region,
    cashier_id,
    customer_id,
    transaction_date,
    transaction_time,
    product_sku,
    product_name,
    category,
    subcategory,
    quantity,
    unit_price,
    discount_pct,
    total_amount,
    payment_method,
    loyalty_points)
VALUES (
    bsc.transaction_id,
    bsc.store_id,
    bsc.store_name,
    bsc.store_city,
    bsc.store_region,
    bsc.cashier_id,
    bsc.customer_id,
    bsc.transaction_date,
    bsc.transaction_time,
    bsc.product_sku,
    bsc.product_name,
    bsc.category,
    bsc.subcategory,
    bsc.quantity,
    bsc.unit_price,
    bsc.discount_pct,
    bsc.total_amount,
    bsc.payment_method,
    bsc.loyalty_points
);


